# TarshishDEX staging/QA environment.
# Copy to .env.local or set these variables in the staging deployment.

# Staging QA uses Stellar Testnet by default.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Keep server logs verbose while QA is in progress.
LOG_LEVEL=debug

# Replace these with the real staging origin before deploying.
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Shared Testnet contract IDs from .env.example.
NEXT_PUBLIC_TRADING_PREFERENCES_CONTRACT_ID=CBCFZA7IONESTWX3YEP76UAPNQD3UQ6NU4INECNDXP2YVXUOR2H33JKM
NEXT_PUBLIC_MARKET_ORACLE_CONTRACT_ID=CBWISHEEE7W2WFXUPYX3R4HFOM54RYM3PQUXYCCTMZ5VNEOIKOZSUS7V

# E2E base URL for the staging deployment.
E2E_BASE_URL=https://staging.example.com
