# ── TarshishDEX staging/QA environment ──────────────────────────────────
# Copy to `.env.local` for local QA runs, or set these variables in the
# staging deployment. Staging uses Stellar Testnet with debug logging.

# ── Network ────────────────────────────────────────────────────────────
# Staging QA runs against Stellar Testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── Application ─────────────────────────────────────────────────────────
# Public base URL of the staging deployment (used for SEO metadata and
# OpenGraph). Replace with the real staging origin before deploying.
NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Application log level for server-side logging.
# Valid values: debug, info, warn, error (default: info)
LOG_LEVEL=debug

# ── Soroban Contracts (Testnet) ─────────────────────────────────────────
# Shared Testnet contract IDs from .env.example. Replace with your own
# if you deploy fresh contracts for the staging environment.
NEXT_PUBLIC_TRADING_PREFERENCES_CONTRACT_ID=CDEXBPA5LPASJR5B2Z4EBKJ74GHT66LDPL5XXBZ4ATHL4XJKI6HQVCAM
NEXT_PUBLIC_MARKET_ORACLE_CONTRACT_ID=CBL2NE3OKPHOZTABVODI6PX4RCMEOKIC7WOO4TUYPUW43HUG7GCSC5N5
NEXT_PUBLIC_LIMIT_ORDER_CONTRACT_ID=CDPHVZHRTBYVOXOV2TUXSSGGZUK2A6IUGFKA7ACKACMORJDKFGYQMACM

# ── Testing ─────────────────────────────────────────────────────────────
# E2E base URL for the staging deployment.
E2E_BASE_URL=https://staging.example.com