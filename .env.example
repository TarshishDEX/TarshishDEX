# ── TarshishDEX environment configuration ──────────────────────────────
# Copy to `.env.local` for local development or set in your deployment.

# Stellar network: "testnet" (default) or "public"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Server-side Horizon URL override (optional). When unset, the active
# network's default Horizon endpoint is used.
# HORIZON_URL=https://horizon-testnet.stellar.org

# Minimum log level for server-side logs: debug | info | warn | error
LOG_LEVEL=info

# Public base URL of the deployed app (used for links/metadata)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL of the deployed app (used for SEO metadata and OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployed Soroban contract IDs on Stellar Testnet (see docs/deployment.md).
# These are the project's shared Testnet instances — replace them if you deploy
your own contracts.
NEXT_PUBLIC_TRADING_PREFERENCES_CONTRACT_ID=CBCFZA7IONESTWX3YEP76UAPNQD3UQ6NU4INECNDXP2YVXUOR2H33JKM
NEXT_PUBLIC_MARKET_ORACLE_CONTRACT_ID=CBWISHEEE7W2WFXUPYX3R4HFOM54RYM3PQUXYCCTMZ5VNEOIKOZSUS7V
NEXT_PUBLIC_LIMIT_ORDER_CONTRACT_ID=

# E2E test base URL (local or deployed).
E2E_BASE_URL=http://localhost:3000

# Application log level for server-side logging.
# Valid values: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Server port override for the Next.js server (default: 3000).
# PORT=3000

# Node environment (production, development, test).
# NODE_ENV=production
