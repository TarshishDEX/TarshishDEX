# ── TarshishDEX environment configuration ──────────────────────────────
# Copy to `.env.local` for local development or set in your deployment.

# ── Network ────────────────────────────────────────────────────────────
# Stellar network: "testnet" (default) or "public"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Server-side Horizon URL override (optional). When unset, the active
# network's default Horizon endpoint is used.
# HORIZON_URL=https://horizon-testnet.stellar.org

# ── Application ─────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for SEO metadata and OpenGraph).
NEXT_PUBLIC_SITE_URL=https://tarshishdex.vercel.app

# Server port override for the Next.js server (default: 3000).
# PORT=3000

# Application log level for server-side logging.
# Valid values: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ── Soroban Contracts (Testnet) ─────────────────────────────────────────
# Deployed contract IDs (see docs/deployment.md). Replace with your own
# if you deploy fresh contracts.
NEXT_PUBLIC_TRADING_PREFERENCES_CONTRACT_ID=CDEXBPA5LPASJR5B2Z4EBKJ74GHT66LDPL5XXBZ4ATHL4XJKI6HQVCAM
NEXT_PUBLIC_MARKET_ORACLE_CONTRACT_ID=CBL2NE3OKPHOZTABVODI6PX4RCMEOKIC7WOO4TUYPUW43HUG7GCSC5N5
NEXT_PUBLIC_LIMIT_ORDER_CONTRACT_ID=CDPHVZHRTBYVOXOV2TUXSSGGZUK2A6IUGFKA7ACKACMORJDKFGYQMACM

# ── Fees ────────────────────────────────────────────────────────────────
# Fee collector address (defaults to project treasury on Testnet).
# Override for mainnet deployments with your own treasury.
# NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ── Testing ─────────────────────────────────────────────────────────────
# E2E test base URL (local or deployed).
E2E_BASE_URL=http://localhost:3000
